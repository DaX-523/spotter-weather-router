# Copy to backend/.env for local development. Never commit .env.
# Generate a key with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Free key from https://developer.tomtom.com (routing and place search).
TOMTOM_API_KEY=
